[sub_resource type="Resource" id="q1"]
script = ExtResource("2")
id = "beat_01"
title = "Beat 1: Escape the Ranger Outpost"
summary = "Treat your wounds, scavenge the emergency kit, and get out of the overrun outpost."
act = 1
beat = 1
objectives = [{ "id": "o1", "type": "search", "target": "outpost_cache", "label": "Scavenge the emergency kit", "count": 1 }, { "id": "o2", "type": "visit", "target": "pine_trail", "label": "Reach the Old Pine Road", "count": 1 }]
next_quest = "beat_02"

[sub_resource type="Resource" id="q2"]
